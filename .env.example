# Production server (server/index.ts)
PORT=3000
# where the SQLite database lives; mount a persistent volume here
DATA_DIR=/data
# enables the moderation page /admin; use a long random value: openssl rand -base64 32
ADMIN_TOKEN=
# reports after which a design is hidden until a moderator looks at it
REPORT_THRESHOLD=3
# salt for hashing anonymous browser ids (set once, keep it secret)
VOTER_SALT=
# absolute site URL for share pages (defaults to the request origin)
PUBLIC_URL=https://coaster2stl.printer.tools
